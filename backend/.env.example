# ==============================================================================
# BY Solutions Backend Environment Variables Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local configuration.
# - NEVER commit the real '.env' file containing real secrets to version control.
# - Replace all placeholder values below with your actual credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (e.g. http://localhost:5500 or https://yourdomain.com)
FRONTEND_URL=http://localhost:5500

# MongoDB Atlas Database Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/bysolutions?retryWrites=true&w=majority

# Zoho SMTP Email Configuration
EMAIL_USER=notifications@yourdomain.com
EMAIL_PASS=your_secure_zoho_app_password
COMPANY_EMAIL=sales@yourdomain.com
